# 인증키 포함 설정 (실제 값 — 절대 커밋 금지)
config.yaml
.env

# 수집 원본 — Actions Artifact로 보존한다 (명세서 v3.1 §4)
data/raw/
data/inbox/
data/exports/
data/backups/

# 작업 중 DB — publish/ 스냅샷만 배포한다 (명세서 v3.1 §3)
work/
*.sqlite3-wal
*.sqlite3-shm

# 생성 산출물 — rate-data 브랜치로 배포한다
site/
site-public/
publish/

# 파이썬 기본
__pycache__/
*.pyc
.venv/
.pytest_cache/
.ruff_cache/
*.egg-info/

# 발행 직전 스테이지 — Actions에서만 만든다
stage/

# 다른 프로젝트에서 이식한 Claude 스킬은 다시 싣지 않는다.
#
# 2026-08-06에 23개가 통째로 들어왔다가 19개를 지웠다. 이 저장소가 쓰는
# 것은 훅이 강제하는 work-completion-report와 방법론 3종뿐이다. 나머지는
# 남의 저작물이고, 공개 저장소에 재배포할 근거가 없다.
.claude/skills/*
!.claude/skills/work-completion-report/
!.claude/skills/magic-number-audit/
!.claude/skills/deploy-staleness-check/
!.claude/skills/log-driven-integration-debug/
