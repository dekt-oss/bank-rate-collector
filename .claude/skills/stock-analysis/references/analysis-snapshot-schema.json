{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Stock Analysis Snapshot",
  "type": "object",
  "required": [
    "analysis_date",
    "analysis_status",
    "component_scores",
    "core_thesis",
    "critical_missing",
    "data_cutoffs",
    "invalidation_conditions",
    "overall_basis",
    "reference_price",
    "scores",
    "security",
    "watchpoints",
    "weighted_coverage"
  ],
  "properties": {
    "security": {
      "type": "object",
      "required": [
        "company",
        "ticker",
        "exchange",
        "currency"
      ],
      "properties": {
        "company": {
          "type": "string"
        },
        "ticker": {
          "type": "string"
        },
        "exchange": {
          "type": "string"
        },
        "currency": {
          "type": "string"
        },
        "share_class": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "analysis_date": {
      "type": "string",
      "format": "date"
    },
    "reference_price": {
      "type": "object",
      "required": [
        "value",
        "currency",
        "timestamp",
        "price_type",
        "verified"
      ],
      "properties": {
        "value": {
          "type": [
            "number",
            "null"
          ]
        },
        "currency": {
          "type": [
            "string",
            "null"
          ]
        },
        "timestamp": {
          "type": [
            "string",
            "null"
          ]
        },
        "price_type": {
          "enum": [
            "live",
            "delayed",
            "latest_close",
            "other"
          ]
        },
        "verified": {
          "type": "boolean"
        }
      }
    },
    "scores": {
      "type": "object",
      "required": [
        "fundamental",
        "timing",
        "overall",
        "confidence_grade"
      ],
      "properties": {
        "fundamental": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 10
        },
        "timing": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 10
        },
        "overall": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 10
        },
        "confidence_grade": {
          "enum": [
            "A",
            "B",
            "C",
            "D"
          ]
        },
        "provisional": {
          "type": "boolean"
        }
      }
    },
    "component_scores": {
      "type": "object",
      "properties": {
        "fundamental": {
          "type": "object",
          "properties": {
            "valuation": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0,
              "maximum": 10
            },
            "earnings_outlook": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0,
              "maximum": 10
            },
            "business_quality": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0,
              "maximum": 10
            },
            "catalysts": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0,
              "maximum": 10
            },
            "downside_resilience": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0,
              "maximum": 10
            },
            "capital_allocation": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0,
              "maximum": 10
            }
          }
        },
        "timing": {
          "type": "object",
          "properties": {
            "technical": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0,
              "maximum": 10
            },
            "flows_positioning": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0,
              "maximum": 10
            },
            "event_setup": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0,
              "maximum": 10
            },
            "sentiment": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0,
              "maximum": 10
            }
          }
        }
      }
    },
    "analysis_status": {
      "enum": [
        "complete",
        "provisional",
        "partial",
        "insufficient_evidence",
        "restricted"
      ]
    },
    "overall_basis": {
      "enum": [
        "fundamental_and_timing",
        "fundamental_only",
        "insufficient_critical_evidence",
        "price_unverified"
      ]
    },
    "weighted_coverage": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "critical_missing": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "estimate_snapshot": {
      "type": "object",
      "properties": {
        "revenue_fy1": {
          "type": [
            "number",
            "null"
          ]
        },
        "revenue_fy2": {
          "type": [
            "number",
            "null"
          ]
        },
        "operating_profit_fy1": {
          "type": [
            "number",
            "null"
          ]
        },
        "operating_profit_fy2": {
          "type": [
            "number",
            "null"
          ]
        },
        "eps_fy1": {
          "type": [
            "number",
            "null"
          ]
        },
        "eps_fy2": {
          "type": [
            "number",
            "null"
          ]
        },
        "estimate_currency": {
          "type": [
            "string",
            "null"
          ]
        },
        "consensus_date": {
          "type": [
            "string",
            "null"
          ]
        },
        "analyst_count": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        }
      }
    },
    "valuation_snapshot": {
      "type": "object",
      "properties": {
        "primary_method": {
          "type": [
            "string",
            "null"
          ]
        },
        "current_multiple": {
          "type": [
            "number",
            "null"
          ]
        },
        "peer_median": {
          "type": [
            "number",
            "null"
          ]
        },
        "historical_median": {
          "type": [
            "number",
            "null"
          ]
        },
        "target_multiple": {
          "type": [
            "number",
            "null"
          ]
        },
        "base_fair_value": {
          "type": [
            "number",
            "null"
          ]
        },
        "bear_fair_value": {
          "type": [
            "number",
            "null"
          ]
        },
        "bull_fair_value": {
          "type": [
            "number",
            "null"
          ]
        }
      }
    },
    "data_cutoffs": {
      "type": "object",
      "properties": {
        "price": {
          "type": [
            "string",
            "null"
          ]
        },
        "financials": {
          "type": [
            "string",
            "null"
          ]
        },
        "consensus": {
          "type": [
            "string",
            "null"
          ]
        },
        "flows": {
          "type": [
            "string",
            "null"
          ]
        },
        "news": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "core_thesis": {
      "type": "string"
    },
    "anti_thesis": {
      "type": [
        "string",
        "null"
      ]
    },
    "invalidation_conditions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "watchpoints": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "items": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "object",
            "required": [
              "id",
              "metric",
              "status"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "metric": {
                "type": "string"
              },
              "expected_condition": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "deadline": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "status": {
                "enum": [
                  "pending",
                  "met",
                  "missed",
                  "delayed",
                  "not_verifiable"
                ]
              },
              "last_checked_at": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "evidence": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "impact_if_met": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "impact_if_missed": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        ]
      },
      "$comment": "String items are accepted only when reading pre-v1.2.1 snapshots. New snapshots must emit object watchpoints only."
    },
    "consensus_as_of": {
      "type": [
        "string",
        "null"
      ]
    },
    "latest_reported_period": {
      "type": [
        "string",
        "null"
      ]
    },
    "notes": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}